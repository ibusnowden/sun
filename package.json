{
  "name": "@ibusnowden/sun",
  "version": "0.1.0",
  "description": "A simple TypeScript coding agent with a responsive terminal UI",
  "type": "module",
  "license": "MIT",
  "author": "Ibra Niang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibusnowden/sun.git"
  },
  "keywords": [
    "coding-agent",
    "terminal",
    "tui",
    "llm",
    "openai-compatible",
    "bun"
  ],
  "private": true,
  "bin": {
    "sun": "./src/cli.ts"
  },
  "files": [
    "src",
    "prompts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test",
    "build": "bun build --compile --minify src/cli.ts --outfile dist/sun",
    "prepack": "bun run check"
  },
  "dependencies": {
    "openai": "6.49.0",
    "smol-toml": "1.7.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "os": [
    "linux"
  ],
  "packageManager": "bun@1.3.13"
}
